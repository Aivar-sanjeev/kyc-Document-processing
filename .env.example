# NVIDIA NIM (OpenAI-compatible chat completions with vision)
# https://build.nvidia.com/ — create an API key and select llama-3.2-90b-vision-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Timeouts and upload limits
REQUEST_TIMEOUT_S=120
MAX_UPLOAD_MB=15

# Set true for local pytest / demos without calling NIM (returns a fixed PAN payload)
USE_MOCK_VISION=false
